# Optional: raises GitHub public API rate limit from 60/hr to 5000/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# Required only for the "Export to Google Sheets" feature.
# Path to a Google Cloud service-account JSON key with Sheets API access.
# Share the target spreadsheet with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
